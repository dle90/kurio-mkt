META_ACCESS_TOKEN=EAAxxxxxxxxxx
META_AD_ACCOUNT_ID=act_1234567890
META_API_VERSION=v21.0

# --- Getfly CRM (leads + revenue) ---
# Host is the subdomain.getflycrm.com (e.g. ikemso.getflycrm.com)
GETFLY_HOST=
GETFLY_API_KEY=
GETFLY_API_VERSION=v6

# --- Ladipage ---
# Per-account key from app.ladipage.com → Quản lý API.
# Currently scoped to MCP only (page builder); REST endpoints return 401 with it.
# Also embedded as the URL-path token in .mcp.json (see .mcp.json.example).
LADIPAGE_API_KEY=

# --- Leads Google Sheet (Kurio's daily lead log) ---
# Sheet ID is the long string in the share URL: docs.google.com/spreadsheets/d/<ID>/...
# GID is the tab id (after gid= in the URL).
LEADS_SHEET_ID=
LEADS_SHEET_GID=

# --- Kurio product DB (Phase 3: retention/LTV — not yet wired) ---
KURIO_DB_HOST=
KURIO_DB_PORT=5432
KURIO_DB_NAME=
KURIO_DB_USER=
KURIO_DB_PASSWORD=

# --- Dashboard server (src/server/index.js) ---
# DATA_DIR points at the directory where .cache/, data/, out/ live.
# Locally: leave unset (defaults to repo root). On Railway: set to /data and
# mount a persistent volume at that path so cache/output files survive restarts.
DATA_DIR=

# Postgres for build-run tracking + cooldown state across restarts.
# Railway injects this automatically when you attach a Postgres plugin.
# Leave unset to run in in-memory mode (cooldown resets on restart).
DATABASE_URL=

# HTTP basic auth on POST /refresh — anyone hitting the URL can see the
# dashboard, but only authed users can trigger a rebuild.
DASHBOARD_USER=kurio
DASHBOARD_PASSWORD=

# Port Railway will inject this automatically; local default is 3000.
PORT=3000
